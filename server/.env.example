PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/reliable-drives
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional Cloudinary uploads. Leave blank to use local /uploads storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used by npm run seed:admin
ADMIN_USERNAME=choose-a-private-owner-username
ADMIN_PASSWORD=replace-with-a-strong-unique-password
